# OpenVPN Configuration
OPENVPN_USERNAME=your_vpn_username
OPENVPN_PASSWORD=your_vpn_password

# SOCKS5 Proxy Configuration  
SOCKS_PORT=18080
SOCKS5_USERNAME=
SOCKS5_PASSWORD=

# Features
ENABLE_UDP=true
USE_HOST_NETWORK=false

# Timezone
TZ=UTC

# Example values - replace with your actual credentials
# OPENVPN_USERNAME=user@vpnprovider.com
# OPENVPN_PASSWORD=your_secure_vpn_password
# SOCKS5_USERNAME=proxy_user
# SOCKS5_PASSWORD=proxy_pass
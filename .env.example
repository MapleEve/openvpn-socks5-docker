# ============================================
# OpenVPN Configuration / OpenVPN 配置
# ============================================

# OpenVPN config file path inside container / 容器内 OpenVPN 配置文件路径
# Default: /config/config.ovpn
OPENVPN_CONFIG_FILE=/config/config.ovpn

# OpenVPN username (leave empty if not required) / OpenVPN 用户名（如不需要请留空）
OPENVPN_USERNAME=

# OpenVPN password (leave empty if not required) / OpenVPN 密码（如不需要请留空）
OPENVPN_PASSWORD=

# ============================================
# SOCKS5 Proxy Configuration / SOCKS5 代理配置
# ============================================

# SOCKS5 proxy listening port / SOCKS5 代理监听端口
# Default: 18080
SOCKS_PORT=18080

# SOCKS5 authentication username (optional) / SOCKS5 认证用户名（可选）
# Leave empty to disable SOCKS5 authentication / 留空则禁用 SOCKS5 认证
SOCKS5_USERNAME=

# SOCKS5 authentication password (optional) / SOCKS5 认证密码（可选）
# Leave empty to disable SOCKS5 authentication / 留空则禁用 SOCKS5 认证
SOCKS5_PASSWORD=

# ============================================
# Feature Toggles / 功能开关
# ============================================

# Enable UDP relay support / 启用 UDP 中继支持
# true = UDP enabled, false = TCP only / true = 启用 UDP，false = 仅 TCP
ENABLE_UDP=true

# Use host network mode / 使用主机网络模式
# true = host network, false = bridge network / true = 主机网络，false = 桥接网络
# Warning: Host network mode may cause port conflicts / 警告：主机网络模式可能导致端口冲突
USE_HOST_NETWORK=false

# ============================================
# System Configuration / 系统配置
# ============================================

# Container timezone / 容器时区
# Examples: UTC, Asia/Shanghai, America/New_York
TZ=UTC

# ============================================
# Example Values / 示例值
# ============================================
# Remove the '#' to use these examples / 删除 '#' 以使用这些示例
#
# OPENVPN_USERNAME=user@vpnprovider.com
# OPENVPN_PASSWORD=your_secure_vpn_password
# SOCKS5_USERNAME=proxy_user
# SOCKS5_PASSWORD=proxy_pass
# TZ=Asia/Shanghai